#include<iostream>
using namespace std;

void insertion(int arr[], int &n, int pos, int value){
    
    if(n == 100){
        cout << "array is full";
        return;
    }
    
    for(int i = n-1; i >= pos; i--){
        arr[i+1] = arr[i];
        
    }
    
    arr[pos] = value;
    n++;
        
    
}

int main(){
    int n;
    cin >> n;
    
    int pos;
    cin >> pos;
    
    int value;
    cin >> value;
    
    int arr[100];
    for(int i = 0; i < n; i++){
        cin >> arr[i];
    }
    
    insertion(arr, n, pos, value);
    
    for(int i = 0; i < n; i++){
        cout << arr[i]<<" ";
    }
}
