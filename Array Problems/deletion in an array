#include<iostream>
using namespace std;

void deletion(int arr[], int &n, int pos){
    
    for(int i = pos; i < n-1; i++){
        arr[i] = arr[i+1];
        
    }
    
    n--;   
    
}

int main(){
    int n;
    cin >> n;
    
    int pos;
    cin >> pos;
    
    int arr[100];
    for(int i = 0; i < n; i++){
        cin >> arr[i];
    }
    
    deletion(arr,n,pos);
    
    for(int i = 0; i < n; i++){
        cout << arr[i]<<" ";
    }
}
