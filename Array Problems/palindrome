#include<iostream>

using namespace std;

bool recursive(int arr[], int n, int i, int j){
    
    while(i <= j){
        if(arr[i] == arr[j]){
            i++;
            j--;
            
        }
        
        else{
            return false;
        }
        
    }
    
    return true;
    
}

int main(){
    int n;
    cin >> n;
    
    int arr[100];
    for(int i = 0; i < n; i++){
        cin >> arr[i];
    }
    
    int i = 0;
    int j = n-1;
    int result = recursive(arr,n,i,j);
    
    cout << result;
}
