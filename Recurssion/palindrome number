#include<iostream>
using namespace std;

bool recursive(int arr[], int n, int i, int j){
    if(i >= j)
    return true;
    
    if(arr[i] != arr[j])
    return false;
    
    return recursive(arr,n,i+1,j-1);
    
}

int main(){
    
    int n;
    cin >> n;
    
    int i = 0;
    int j = n-1;
     
    int arr[100];
    
    for(int i = 0; i < n; i++){
        cin >> arr[i];
    }
    
    cout << recursive(arr,n,i,j);
    
}
